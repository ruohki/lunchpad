{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lunchpad",
  "version": "1.1.2",
  "identifier": "com.lunchpad.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lunchpad",
        "width": 780,
        "height": 820,
        "minWidth": 660,
        "minHeight": 600,
        "backgroundColor": "#0b0b0f",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Turn a Novation Launchpad into a macro controller",
    "longDescription": "Lunchpad turns Novation Launchpads and Launchkey Minis into macro controllers: sounds, hotkeys, OBS and Streamlabs, Home Assistant, web requests and scripts on every pad.",
    "linux": {
      "deb": {
        "depends": ["libasound2", "libspeechd2", "libdbus-1-3"],
        "recommends": ["speech-dispatcher", "pulseaudio-utils"]
      },
      "rpm": {
        "depends": ["libasound.so.2()(64bit)", "libspeechd.so.2()(64bit)", "libdbus-1.so.3()(64bit)"],
        "recommends": ["speech-dispatcher", "pulseaudio-utils"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1QzhGNjdBNjJDODZGMUUKUldRZWI4aGlldmJJNVhLU0QrM0VvSGdFQjZFV2pZRThQRU14WTFZRkw5KzZyM01KVEZjeitoaDcK",
      "endpoints": [
        "https://github.com/ruohki/lunchpad/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
